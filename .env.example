# Configuración de Base de Datos
DB_HOST=db
DB_BASE=condominios
DB_USR=root
DB_PASS=your_secure_password_here

# Configuración de Email (para recuperación de contraseñas)
EMAIL_USR=your_email@example.com
EMAIL_PASS=your_email_app_password_here

# Clave de encriptación (AES-256-CBC) - Genera una clave aleatoria segura
# openssl rand -base64 32
ENCRYPTION_KEY=your_encryption_key_here

# URL del sitio (opcional, se auto-detecta si no se especifica)
# SITE_URL=http://localhost:9000/
